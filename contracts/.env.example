# Copy to .env and fill with local deployment credentials.

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Optional. Required only when running with VERIFY=true.
ETHERSCAN_API_KEY=

# Set to true to pass --verify to forge script.
VERIFY=false
